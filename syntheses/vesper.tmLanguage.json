{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vesper",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#comments" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vesper",
          "match": "\\b(if|else|for|while|return|fn|struct|mut|let|in|import)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vesper",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.vesper", "match": "\\\\." }
      ]
    },
    "numbers": {
      "name": "constant.numeric.vesper",
      "match": "\\b([0-9]+(\\.[0-9]+)?|\\.[0-9]+)\\b"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.vesper",
          "begin": "##",
          "end": "##"
        },
        {
          "name": "comment.line.vesper",
          "match": "#.*$"
        }
      ]
    }
  },
  "scopeName": "source.vesper"
}
