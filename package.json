{
  "name": "vesper-vscode",
  "displayName": "Vesper VSCode",
  "version": "0.1.4",
  "description": "Language support and formatter for Vesper (.vsp) for Windows. Includes syntax highlighting, file icons, and auto-formatting.",
  "license": "ISC",
  "author": "tajultonim",
  "publisher": "tajultonim",
  "icon": "icons/vesper-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tajultonim/vesper-vscode.git"
  },
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:vesper"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vesper",
        "aliases": [
          "Vesper",
          "vesper"
        ],
        "extensions": [
          ".vsp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vesper-icon.svg",
          "dark": "./icons/vesper-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "vesper",
        "scopeName": "source.vesper",
        "path": "./syntheses/vesper.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "vesper-icons",
        "label": "Vesper File Icons",
        "path": "./icons/icon-theme.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Vesper Configuration",
      "properties": {
        "vesper.formatterPath": {
          "type": "string",
          "default": "",
          "description": "Optional custom path to vspfmt.exe. Leave blank to use the default bundled bin/vspfmt.exe."
        },
        "vesper.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to vesper.exe. Leave blank to use a bundled interpreter or build/vesper.exe from the workspace."
        }
      }
    },
    "commands": [
      {
        "command": "vesper.formatDocument",
        "title": "Vesper: Format Document"
      },
      {
        "command": "vesper.runFile",
        "title": "Vesper: Run File"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vesper.runFile",
          "when": "editorLangId == vesper",
          "group": "navigation@1"
        },
        {
          "command": "vesper.formatDocument",
          "when": "editorLangId == vesper",
          "group": "navigation@2"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
